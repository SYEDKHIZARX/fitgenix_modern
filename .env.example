# Copy this file to `.env` in the project root (never commit `.env`).
# Used by FastAPI (api/main.py via python-dotenv).

# Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Prefer the **anon / publishable** key for local dev.
# Use SUPABASE_SERVICE_KEY only on a trusted server (bypasses RLS).
# Never put a service/secret key in the browser or NEXT_PUBLIC_* vars.
SUPABASE_KEY=your_anon_or_publishable_key

# Optional: service role for server-side writes that need full DB access
# SUPABASE_SERVICE_KEY=your_service_role_or_secret_key

# Comma-separated browser origins allowed to call this API (CORS)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
